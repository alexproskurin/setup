{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "node '__AGENT_BOARD__' session-start --format codex", "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "node '__AGENT_BOARD__' post-tool --format codex", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node '__AGENT_BOARD__' stop --format codex", "timeout": 60 }
        ]
      }
    ]
  }
}
